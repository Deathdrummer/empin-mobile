{
  "cli": {
    "version": ">= 16.24.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "sdk-54",
        "credentialsSource": "local",
        "env": {
          "IOS_WITHOUT_FIREBASE": "true"
        }
      }
    },
    "testflight": {
      "extends": "production",
      "credentialsSource": "local",
      "environment": "production",
      "env": {
        "IOS_WITHOUT_FIREBASE": "true"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "appleId": "vlad161rswork@gmail.com",
        "ascAppId": "6817777415"
      }
    }
  }
}
