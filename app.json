{
  "expo": {
    "name": "empin-mobile",
    "slug": "empin-mobile",
    "owner": "empin",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.deathdrumer.empinmobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Разрешите доступ к камере, чтобы снимать фото и видео для чатов, комментариев и фото профиля",
        "NSPhotoLibraryUsageDescription": "Разрешите доступ к галерее, чтобы отправлять фото и видео в чаты и комментарии и выбрать фото профиля",
        "NSMicrophoneUsageDescription": "Разрешите доступ к микрофону для звонков, голосовых сообщений, записи видео с камеры и голосового ввода текста",
        "NSSpeechRecognitionUsageDescription": "Разрешите доступ к распознаванию речи для голосового ввода текста",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "CFBundleDevelopmentRegion": "ru",
        "CFBundleLocalizations": [
          "ru"
        ],
        "NSPhotoLibraryAddUsageDescription": "Разрешите сохранять фото и видео из чатов в галерею",
        "NSUserActivityTypes": [
          "INStartCallIntent",
          "INStartAudioCallIntent"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#160204"
      },
      "edgeToEdgeEnabled": true,
      "package": "ru.deathdrumer.empinmobile",
      "versionCode": 11,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "WAKE_LOCK",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withFirebaseMessagingPriority",
      "./plugins/withScreenOnCallFix",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-speech-recognition",
      [
        "react-native-full-screen-notification-incoming-call",
        {
          "statusBarColor": "#000000"
        }
      ],
      "./plugins/withAndroidReleaseManifest",
      "expo-asset",
      [
        "./plugins/withAppDisplayName",
        {
          "displayName": "Эмпин PRO"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Датчик движения используется для обновления табеля при встряхивании телефона"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f6eb001a-e226-4bfc-acd6-8b5e10107463"
      }
    }
  }
}
